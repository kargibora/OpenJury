{
  "dataset": "alpaca-eval",
  "n_instructions": 10,

  "models": [
    "VLLM/Qwen/Qwen2.5-1.5B-Instruct",
    "OpenRouter/qwen/qwen3-8b"
  ],

  "judge": {
    "model": "VLLM/Qwen/Qwen3-32B",
    "gpus": 2,
    "mode": "pairwise",
    "max_tokens": 2048
  },

  "rubric": "default",

  "matchmaker": {
    "strategy": "random_pairs",
    "n_matches": 10

  },

  "generation": {
    "max_tokens": 4096,
    "ignore_cache": false,
    "ignore_score_cache": false
  },

  "output_dir": "results/arena/2model-battle",

  "ratings": {
    "bt_regularization": 0.01,
    "elo_k": 32.0
  },

  "include_completions": false,
  "include_raw_judge": false
}
